// カエルの歌 楽譜データ
// 60=ド, 62=レ, 64=ミ, 65=ファ, 67=ソ, 69=ラ, 0=休符
int nt[] = {60, 62, 64, 65, 64, 62, 60, 0,
            64, 65, 67, 69, 67, 65, 64, 0,
            60, 0,  60, 0,  60, 0,  60, 0,
            60, 60, 62, 62, 64, 64, 65, 65, 64, 62, 60, 0};

// 音符の長さ（ミリ秒単位：400=4分音符, 200=8分音符）
int dr[] = {400, 400, 400, 400, 400, 400, 400, 400,
            400, 400, 400, 400, 400, 400, 400, 400,
            400, 400, 400, 400, 400, 400, 400, 400,
            200, 200, 200, 200, 200, 200, 200, 200, 400, 400, 400, 400};

int len = 36; // 総データ数
int idx = 0;  // 再生位置のインデックス

void setup() {
  Serial.begin(9600); // シリアル通信の開始
}

void loop() {
  if (idx < len) {

    tx(nt[idx], 100, dr[idx]);
    
    // 音符の長さ分待つことで、次の音を出すタイミングを制御
    delay(dr[idx]); 
    idx++;
  } else {
    idx = 0; // 曲が終わったら最初からループ
    delay(2000); // ループの間の休止
  }
}

// データをシリアル出力する短い名称の独自関数
void tx(int p, int v, int d) {
  Serial.print(p);
  Serial.print(",");
  Serial.print(v);
  Serial.print(",");
  Serial.println(d);
}